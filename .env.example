# Configuração do deploy com Docker Compose (`docker-compose.yml`).
# Copie para `.env` e ajuste as URLs públicas (como o navegador do usuário
# acessa cada serviço — com o domínio/HTTPS do proxy reverso, se houver).

# URL pública do frontend: liberada no CORS do backend.
FRONTEND_PUBLIC_URL=http://localhost:3000
# URL pública da API: embutida no frontend no build (mudar exige --build).
API_PUBLIC_URL=http://localhost:8000

# Portas publicadas no host.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Processos do uvicorn no backend (a simulação é CPU-bound: ~1 por núcleo).
BACKEND_WORKERS=2
